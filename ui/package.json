{
  "name": "opradar-ui",
  "private": true,
  "version": "1.0.0",
  "description": "Opportunity Radar viewer. `npm run build` writes dist/app.html, the template that `python -m opradar.ui` fills with data.",
  "type": "module",
  "scripts": {
    "dev": "vite --open /app.html",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --open /app.html"
  },
  "dependencies": {
    "@types/matter-js": "^0.20.2",
    "matter-js": "^0.20.0",
    "motion": "^13.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vite-plugin-singlefile": "^2.2.0"
  }
}
